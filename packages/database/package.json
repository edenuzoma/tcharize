{
  "name": "@tcharize/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').renameSync('dist/index.js','dist/index.cjs')\"",
    "generate": "prisma generate",
    "migrate": "node --env-file-if-exists=../../.env.local ../../node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "node scripts/deploy-migrations.mjs",
    "studio": "node --env-file-if-exists=../../.env.local ../../node_modules/prisma/build/index.js studio --schema prisma/schema.prisma",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "prisma": "^6.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}

