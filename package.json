{
  "name": "tcharize",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @tcharize/database generate",
    "db:migrate": "pnpm --filter @tcharize/database migrate",
    "db:studio": "pnpm --filter @tcharize/database studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}

