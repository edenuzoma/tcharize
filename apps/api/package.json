{
  "name": "@tcharize/api",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @tcharize/contracts build && pnpm --filter @tcharize/database generate && pnpm --filter @tcharize/database build && nest build",
    "start": "pnpm --filter @tcharize/database migrate:deploy && node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@tcharize/contracts": "workspace:*",
    "@tcharize/database": "workspace:*",
    "ioredis": "^5.8.1",
    "nodemailer": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.8",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
